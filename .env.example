DJANGO_ADMIN_URL=admin_path/
STATIC_ROOT=/backend_static/static
MEDIA_ROOT=/app/media
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
