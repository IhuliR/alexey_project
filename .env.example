CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
POSTGRES_USER=django_user
POSTGRES_PASSWORD=some_password
POSTGRES_DB=django
DB_HOST=db
DB_PORT=5432
